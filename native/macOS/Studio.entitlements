<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Droits de l'app signée « Developer ID » (voir build-mac.sh, SIGN_IDENTITY). La notarisation impose le
     « hardened runtime », qui coupe le micro tant qu'il n'est pas demandé ici (notes vocales, Dictation.swift). -->
<plist version="1.0"><dict>
  <key>com.apple.security.device.audio-input</key><true/>
</dict></plist>
